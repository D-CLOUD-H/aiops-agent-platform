# =============================================================================
# AIOps Agent Platform - 云端部署环境变量模板（与 docker-compose.yml 同级）
# 使用方法：cp .env.example .env  → 编辑 .env → ./deploy.sh
# 真实密钥只填在 .env 里，.env 不要上传到 git、不要发给别人
# =============================================================================

# ---------- LLM 模型配置（必填） ----------
# provider 支持：openai / deepseek / mimimax 等
#   openai   : 海外区域服务器可用；国内服务器无法直连 api.openai.com
#   deepseek : DeepSeek（国内服务器可直接访问，LLM_BASE_URL 留空即可）
#   mimimax  : MiniMax（国内可直接访问，需填 LLM_BASE_URL）
LLM_PROVIDER=openai
LLM_API_KEY=your-api-key-here
# 自定义 OpenAI 兼容地址；openai / deepseek 留空即可
LLM_BASE_URL=

# 模型名示例：openai -> gpt-4o-mini；deepseek -> deepseek-chat；mimimax -> MiniMax-Text-01
LLM_MODEL=gpt-4o-mini

# ---------- 兼容配置（一般留空即可） ----------
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ---------- 可选：Langfuse 可观测性（默认关闭，不影响部署） ----------
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
