LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=
LLM_MAX_TOKENS=
LLM_TIMEOUT_SECONDS=
LLM_MAX_RETRIES=

# --- Langfuse Observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# --- Database ---
DATABASE_URL=
DATABASE_POOL_SIZE=
DATABASE_MAX_OVERFLOW=

# --- ChromaDB ---
CHROMA_DB_PATH=
CHROMA_COLLECTION_NAME=

# --- Agent Configuration ---
AGENT_EXECUTION_TIMEOUT_SECONDS=
AGENT_MAX_ITERATIONS=
AGENT_PARALLEL_WORKERS=
AGENT_HEAL_DRY_RUN=
AGENT_RCA_MIN_CONFIDENCE=

# --- Memory System ---
MEMORY_SHORT_TERM_MAX_ITEMS=
MEMORY_LONG_TERM_MAX_ITEMS=
