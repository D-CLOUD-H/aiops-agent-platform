# =============================================================================
# AIOps Agent Platform - Environment Variables
# =============================================================================

# --- Application ---
APP_ENV=
APP_HOST=
APP_PORT=
APP_LOG_LEVEL=
APP_DEBUG=

# --- LLM Configuration ---
# sharkai OpenAI-compatible endpoint; fill a fresh key locally, never commit it
LLM_PROVIDER=
