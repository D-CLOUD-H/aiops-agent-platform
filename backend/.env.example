MEMORY_RETENTION_DAYS=

# --- WebSocket ---
WS_HEARTBEAT_INTERVAL_SECONDS=
WS_MAX_CONNECTIONS=

# --- Security ---
CORS_ORIGINS=
API_KEY_HEADER=
